rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The user doc itself -- currently just { lastSeenVersion }, tracking
    // which APP_VERSION's release notes this account has already seen (see
    // index.html's checkReleaseNotesAutoPopup), so it follows the account
    // across devices/sessions the same way history/geofences do. Same
    // owner-only rule as the subcollections below.
    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid}/history/{issueId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Materialized plate -> incidents index (see index.html's
    // platesCollection/addToHistory) -- one doc per plate, each holding the
    // ids of every history doc it's linked to. Same owner-only rule as
    // history above.
    match /users/{uid}/plates/{plateId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Materialized USDOT-number -> incidents index (see index.html's
    // usdotNumbersCollection/addToHistory) -- one doc per USDOT number, each
    // holding the ids of every history doc it's linked to, plus a
    // denormalized companyName display field. USDOT is the primary
    // commercial-carrier join key (mirrors plates above). Same owner-only
    // rule as history/plates above.
    match /users/{uid}/usdotNumbers/{usdotId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Materialized company-name -> incidents index (see index.html's
    // companiesCollection/addToHistory) -- a fallback join key used only
    // when a report has no legible USDOT number. Same owner-only rule as
    // history/plates/usdotNumbers above.
    match /users/{uid}/companies/{companyId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Geofences (see index.html's initGeofencesSync/resolveWorkflow and the
    // Geofence Maintenance screen) -- one doc per geofence, fully
    // user-managed (add/edit/delete) from the app. Same owner-only rule as
    // history/plates above.
    match /users/{uid}/geofences/{geofenceId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Municipal Parking Department notification letters (see index.html's
    // "Notify Parking Dept" screen) -- one doc per generated letter. Same
    // owner-only rule as history/plates/geofences above.
    match /users/{uid}/parkingDeptLetters/{letterId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // User-editable settings (currently just settings/parkingDeptLetter:
    // sender/recipient mailing addresses for the Parking Dept letter).
    // Deliberately NOT the config/secrets pattern below -- these are
    // user-owned, user-editable values (not a revocable API key), and they
    // must never live in config.js since that file is committed to a
    // public repo and a home mailing address has no business being there.
    // Same owner-only rule as history/plates/geofences above.
    match /users/{uid}/settings/{settingId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Append-only error log (see index.html's logToConsole/errorLogCollection)
    // -- lets a failure that happens when nobody's watching the in-app debug
    // console still be found later. Create/read only, no update/delete: it's
    // meant as a durable audit trail, not a doc the client should ever
    // rewrite in place. Same owner-only restriction as history/plates above.
    match /users/{uid}/errorLogs/{logId} {
      allow read, create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Runtime secrets (config/secrets: { geminiApiKey, mailStreamApiKey })
    // that shouldn't live in config.js, since that file is committed to a
    // public repo -- Google auto-revokes any service-account-bound key it
    // finds there, and a MailStream key left in a public repo is worse:
    // anyone could use it to print and mail real letters on this account's
    // dime.
    // Read-only from the app -- no allow write, so these can only be set
    // via the Firebase Console, never overwritten by client code.
    match /config/{document} {
      allow read: if request.auth != null
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
