rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/history/{issueId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Runtime secrets (config/secrets: { geminiApiKey }) that shouldn't live
    // in config.js, since that file is committed to a public repo and
    // Google auto-revokes any service-account-bound key it finds there.
    // Read-only from the app -- no allow write, so these can only be set
    // via the Firebase Console, never overwritten by client code.
    match /config/{document} {
      allow read: if request.auth != null
        && request.auth.token.email == 'aschubatis@gmail.com'
        && request.auth.token.email_verified == true;
    }
  }
}
